%%metro x_spacing: 70
%%metro legend: 640,690

graph LR
    subgraph intake [Intake]
        in_data[ ]
        step_a1[Extract]
        step_a2[Trim fast]
        step_a3[Trim slow]
        step_a4[Check]
        step_a5[Split]
        step_a6[Filter one]
        step_a7[Filter two]
        step_a8[Filter three]
        step_a9[Infer setting]

        in_data -->|la,lb,lc| step_a1
        step_a1 -->|la,lb,lc| step_a2
        step_a1 -->|la,lb,lc| step_a3
        step_a2 -->|la,lb,lc| step_a4
        step_a3 -->|la,lb,lc| step_a4
        step_a4 -->|la,lb,lc| step_a5
        step_a5 -->|la,lb,lc| step_a6
        step_a5 -->|la,lb,lc| step_a7
        step_a5 -->|la,lb,lc| step_a8
        step_a6 -->|la,lb,lc| step_a9
        step_a7 -->|la,lb,lc| step_a9
        step_a8 -->|la,lb,lc| step_a9
    end

    subgraph primary [Primary pass]
        step_b1[Map]
        step_b2[Dedup]
        step_b3[Coverage\ntrack]

        step_b1 -->|la,lb,lc| step_b2
        step_b2 -->|la,lb,lc| step_b3
        step_b3 -->|la,lb,lc| out_track
    end

    subgraph discovery [Discovery and scaling]
        step_c1[Assemble]
        step_c2[Compare]
        step_c3[Merge and\nfilter set]
        step_c4[Scale]

        step_c1 -->|lb| step_c2
        step_c2 -->|lb| step_c3
        step_c3 -->|lb| out_ref
        step_c3 -->|lb| step_c4
    end


    subgraph calling [Candidate calling]
        step_d0[Map:\nsecond pass]
        step_d1[Caller one]
        step_d2[Caller two]
        step_d3[Caller three]
        step_d4[Caller four]
        step_d5[Caller five]
        step_d6[Merge\ncatalogue]

        step_d0 -->|la,lc| step_d1
        step_d0 -->|la| step_d2
        step_d0 -->|la| step_d3
        step_d0 -->|la| step_d4
        step_d0 -->|la| step_d5
        step_d1 -->|la,lc| step_d6
        step_d2 -->|la| step_d6
        step_d3 -->|la| step_d6
        step_d4 -->|la| step_d6
        step_d5 -->|la| step_d6
        step_d6 -->|la,lc| out_catalogue
    end

    subgraph marking [Position marking]
        step_e1[Marker one]
        step_e2[Marker two]
        step_e3[Marker trace]
        step_e4[Quantify\nmarkers]

        step_e1 -->|la| report_one
        step_e2 -->|la| step_e3
        step_e3 -->|la| step_e4
    end

    subgraph ratio [Ratio analysis]
        step_f1[Prep counts]
        step_f2[Model one]
        step_f3[Model two]
        step_f4[Model three]
        step_f5[Merge]

        step_f1 -->|la,lb| step_f2
        step_f1 -->|la,lb| step_f3
        step_f1 -->|la,lb| step_f4
        step_f2 -->|la,lb| step_f5
        step_f3 -->|la,lb| step_f5
        step_f4 -->|la,lb| step_f5
        step_f5 -->|la,lb| report_two
    end

    subgraph summary [Summary]
        step_g1[Collect]

        step_g1 -->|la,lb| report_all
    end

    %% Inter-section edges
    step_a9 -->|la,lb,lc| step_b1
    step_b2 -->|lb| step_c1
    step_b2 -->|la,lc| step_d0
    step_c4 -->|lb| step_f1
    step_d6 -->|la| step_e1
    step_d6 -->|la| step_e2
    step_e4 -->|la| step_f1
    step_f5 -->|la,lb| step_g1
