%%metro title: Independent Exit Lane Frames
%%metro line: lower | Lower branch | #3779b1
%%metro line: straight | Straight branch | #156075
%%metro line: ends | Terminates locally | #dde6c4
%%metro line: wrap | Wrap branch | #6ef362
%%metro line: alpha | Alpha | #e76f51
%%metro line: beta | Beta | #6d597a
%%metro line: vertical_l1 | Vertical L1 | #e6194b
%%metro line: vertical_l2 | Vertical L2 | #3cb44b
%%metro line: vertical_l3 | Vertical L3 | #4363d8
%%metro line: vertical_l4 | Vertical L4 | #f58231
%%metro line: side_a | Side A | #00bbf9
%%metro line: side_b | Side B | #00f5d4
%%metro grid: feeder | 0,0
%%metro grid: source | 1,0
%%metro grid: side | 1,1
%%metro grid: straight_target | 2,0
%%metro grid: lower_target | 2,1
%%metro grid: independent_source | 0,3
%%metro grid: independent_target | 1,3
%%metro grid: direct_feeder | 3,0
%%metro grid: direct_source | 4,0
%%metro grid: direct_target | 5,0
%%metro grid: side_work | 4,2
%%metro grid: side_report | 3,2
%%metro grid: vertical_up | 2,3
%%metro grid: vertical_down | 1,4

graph LR
    subgraph feeder [Feeder]
        feed[Feed]
    end
    subgraph source [Settling source]
        before[Before]
        split[Split]
        before -->|lower,wrap,ends,straight| split
    end
    subgraph side [Side]
        side_end[Side]
    end
    subgraph straight_target [Straight target]
        straight_in[Straight]
    end
    subgraph lower_target [Lower target]
        lower_in[Lower]
    end

    subgraph independent_target [Independent target]
        independent_in[Independent in]
    end
    subgraph independent_source [Independent source]
        independent_out[Independent out]
    end

    subgraph direct_feeder [Direct feeder]
        direct_feed[Direct feed]
    end
    subgraph direct_source [Direct source]
        %%metro exit: right | lower, straight
        direct_out[Direct out]
    end
    subgraph direct_target [Vertical direct target]
        %%metro direction: TB
        %%metro entry: left | lower, straight
        direct_in[Direct in]
        direct_done[Direct done]
        direct_in -->|lower,straight| direct_done
    end

    subgraph side_work [Vertical side exit]
        %%metro direction: TB
        %%metro entry: top | side_a, side_b
        %%metro exit: left | side_a, side_b
        side_in[Side in]
        side_out[Side out]
        side_in -->|side_a,side_b| side_out
    end
    subgraph side_report [Side report]
        %%metro entry: right | side_a, side_b
        side_result[Side result]
    end

    subgraph vertical_up [Vertical source]
        %%metro direction: TB
        %%metro entry: top | vertical_l1, vertical_l2, vertical_l3, vertical_l4
        %%metro exit: bottom | vertical_l1, vertical_l2, vertical_l3, vertical_l4
        vertical_a[Vertical A]
        vertical_b[Vertical B]
        vertical_a -->|vertical_l1,vertical_l2,vertical_l3,vertical_l4| vertical_b
    end
    subgraph vertical_down [Vertical target]
        %%metro direction: RL
        %%metro entry: top | vertical_l1, vertical_l2, vertical_l3, vertical_l4
        vertical_c[Vertical C]
        vertical_d[Vertical D]
        vertical_e[Vertical E]
        vertical_c -->|vertical_l1,vertical_l2,vertical_l3,vertical_l4| vertical_d
        vertical_d -->|vertical_l1,vertical_l2,vertical_l3,vertical_l4| vertical_e
    end

    feed -->|lower,wrap,straight| before
    feed -->|wrap| side_end
    split -->|straight| straight_in
    split -->|lower,wrap| lower_in
    independent_out -->|alpha,beta| independent_in
    direct_feed -->|lower,straight| direct_out
    direct_out -->|lower,straight| direct_in
    side_out -->|side_a,side_b| side_result
    vertical_b -->|vertical_l1,vertical_l2,vertical_l3,vertical_l4| vertical_c
