%%metro title: Repeat on the source row
%%metro line: hub | Hub | #8453d7
%%metro line: pair | Pair | #6ef362
%%metro line: mid | Mid | #dde6c4
%%metro line: far | Far | #156075
%%metro grid: src | 0,3
%%metro grid: t0 | 1,3
%%metro grid: t1 | 1,2
%%metro grid: t2 | 1,1
%%metro grid: t3 | 1,0

graph LR
    subgraph src [Source]
        s_in[Source input]
        s_hub[Source hub]
        s_in -->|hub| s_hub
    end
    subgraph t0 [t0]
        t0_a[t0 a]
        t0_b[t0 b]
        t0_a -->|pair| t0_b
    end
    subgraph t1 [t1]
        t1_a[t1 a]
        t1_b[t1 b]
        t1_a -->|pair| t1_b
    end
    subgraph t2 [t2]
        t2_a[t2 a]
        t2_b[t2 b]
        t2_a -->|mid| t2_b
    end
    subgraph t3 [t3]
        t3_a[t3 a]
        t3_b[t3 b]
        t3_a -->|far| t3_b
    end

    s_hub -->|pair| t0_a
    s_hub -->|pair| t1_a
    s_hub -->|mid| t2_a
    s_hub -->|far| t3_a
